# Required — from your Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — only needed for server-only admin operations that must bypass RLS.
# Deliberately NOT used by the certificate routes: certificate visibility is
# enforced by a storage policy that joins back to `lots.published`, so the anon
# key is sufficient and there is no elevated key to leak.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — rate limiting (Upstash Redis, free tier: https://upstash.com)
# Rate limiting is silently disabled (never blocks) if these are unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional — error tracking (Sentry, free tier: https://sentry.io)
# Error tracking is silently disabled if this is unset.
# NEXT_PUBLIC_SENTRY_DSN=

# Optional — only needed to upload source maps to Sentry at build time
# (makes stack traces readable; skipped automatically if unset)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Canonical origin for absolute URLs — sitemap.xml, robots.txt, Open Graph tags
# and JSON-LD. Without it those fall back to the Vercel deployment URL on a
# preview and to localhost in development, which is correct for those contexts
# but wrong for production. Set it to the live domain, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com
